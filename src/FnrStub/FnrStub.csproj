<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ensamblado de REFERENCIA escrito a mano: solo declara los tipos del juego que usa el
       backend, para poder compilar sin el exe. No contiene código del juego.
       En ejecución se usa el FIGHT_N_RAGE.exe real del usuario. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FIGHT_N_RAGE</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0067;CS0649;CS8618</NoWarn>
  </PropertyGroup>
</Project>
